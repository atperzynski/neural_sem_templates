#
# Refuses a commit that would add data to the repository. Turn it on once per clone with
#     git config core.hooksPath .githooks
# The hook needs Python 3.8 or later, which RStudio, Positron and most analysis computers have.
PY=python3
command -v python3 >/dev/null 2>&1 || PY=python
exec "$PY" tools/check_no_data.py --staged
